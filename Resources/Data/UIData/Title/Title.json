            "strTag": "Title_Warning_TitleText_TextData",
            "strText": "경고: 게임 시작 전 숙지하세요",
            "vFontColor": {
                "w": 1.0,
                "x": 0.46332043409347534,
                "y": 0.46332043409347534,
                "z": 0.46332043409347534
